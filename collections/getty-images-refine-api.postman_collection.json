                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mask_url\": \"<string>\",\n  \"reference_asset_id\": \"<string>\",\n  \"reference_generation\": {\n    \"generation_request_id\": \"<string>\",\n    \"index\": \"<integer>\"\n  },\n  \"prompt\": \"<string>\",\n  \"negative_prompt\": \"<string>\",\n  \"product_id\": \"<integer>\",\n  \"project_code\": \"<string>\",\n  \"notes\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
