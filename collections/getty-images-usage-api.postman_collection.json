      "item": [
        {
          "id": "170cb58c-3226-4679-aa2e-ffbfe2f67866",
          "name": "Report usage of assets via a batch format.",
          "request": {
            "name": "Report usage of assets via a batch format.",
            "description": {
              "content": "# Report Usage\n\nUse this endpoint to report the usages of a set of assets. The count of assets submitted in a single batch to this endpoint is limited to 1000. Note that all asset Ids specified must be valid or the operation will fail causing no usages to be recorded. In this case, you will need to remove the invalid asset Ids from the query request and re-submit the query.\n\n##  Quickstart\n\nYou'll need an API key and an access token to use this resource. \n\n_Note_: Date of use can be in any unambiguous date format.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "usage-batches",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) Specifies a unique batch transaction id to identify the report."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_usages\": [\n    {\n      \"asset_id\": \"<string>\",\n      \"quantity\": \"<integer>\",\n      \"usage_date\": \"<dateTime>\"\n    },\n    {\n      \"asset_id\": \"<string>\",\n      \"quantity\": \"<integer>\",\n      \"usage_date\": \"<dateTime>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
